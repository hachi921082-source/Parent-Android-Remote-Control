<UserControl x:Class="FamilyRemote.PcClient.Session.ReconnectingBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FamilyRemote.PcClient.Resources"
             HorizontalAlignment="Center" VerticalAlignment="Top"
             IsHitTestVisible="False" Visibility="Collapsed">
    <!--
        Additive overlay shown on top of the still-visible last video frame while
        ConnectionState is Reconnecting (docs/plans/pc-client/connection-state-ui/PLAN.md §7) —
        never clears whatever content sits underneath it in LiveView. IsHitTestVisible="False" so it
        never intercepts clicks meant for the video/input surface beneath it.
    -->
    <Border Background="#CC000000" CornerRadius="4" Padding="16,8" Margin="0,12,0,0">
        <TextBlock Text="{x:Static res:Strings.SessionReconnectingBanner}"
                   Foreground="White" FontWeight="Bold" />
    </Border>
</UserControl>
