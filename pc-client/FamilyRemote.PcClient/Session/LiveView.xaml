<UserControl x:Class="FamilyRemote.PcClient.Session.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FamilyRemote.PcClient.Session">
    <!--
        Live/Reconnecting content (docs/plans/pc-client/connection-state-ui/PLAN.md §6). Composes:
          - VideoSlot / TapMarkerSlot: EMPTY reserved cells for video-and-session/decode's VideoView
            and input-relay's TapMarkerOverlay (docs/plans/pc-client/README.md §8 build-order tiers
            5/6 -- neither exists yet as of this tier). Left intentionally blank, not stubbed, so
            those tiers can add their control as the sole child of the corresponding Grid cell
            without touching this file's structure.
          - TextInputSlot: same idea, reserved for input-relay's TextInputBar.
          - StatusPanel (ParentStatusPanel): real, functional, this tier's own §6.
          - Banner (ReconnectingBanner): real, functional, this tier's own §7 -- additive overlay,
            never clears VideoSlot's content (there is none yet, but the layout must not assume
            otherwise once Tier 5 lands).
        A fresh LiveView instance is constructed only on a genuinely new Live entry (WaitingForParent
        -> Live); it is reused as-is across Live<->Reconnecting cycles within one connection attempt
        (owned by MainWindow, not this file) so neither video nor zoom state is dropped by a mere
        reconnect blip.
    -->
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="VideoSlot">
            <!-- TODO(video-and-session/decode): VideoView is the sole child of this cell. -->
            <!-- TODO(input-relay): TapMarkerOverlay layers above VideoView, same cell. -->
        </Grid>

        <Border Grid.Row="1" x:Name="TextInputSlot">
            <!-- TODO(input-relay): TextInputBar is the sole child of this cell. -->
        </Border>

        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
            <local:ParentStatusPanel x:Name="StatusPanel" />
        </Border>

        <local:ReconnectingBanner Grid.Row="0" x:Name="Banner" />
    </Grid>
</UserControl>
