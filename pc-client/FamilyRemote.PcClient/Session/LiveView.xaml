<UserControl x:Class="FamilyRemote.PcClient.Session.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FamilyRemote.PcClient.Session"
             xmlns:video="clr-namespace:FamilyRemote.PcClient.Video"
             xmlns:input="clr-namespace:FamilyRemote.PcClient.Input">
    <!--
        Live/Reconnecting content (docs/plans/pc-client/connection-state-ui/PLAN.md §6). Composes:
          - VideoSlot: hosts Video (VideoView, video-and-session/decode.PLAN.md §2/§6) as its first
            child, with Overlay (input-relay's TapMarkerOverlay, PLAN.md §6/§8) layered above it in
            the same cell — Overlay also carries the view-only-mode banner (PLAN.md §8), since it's
            the one control layered above the video.
          - TextInputSlot: hosts TextBar (input-relay's TextInputBar, PLAN.md §7) as its sole child.
          - StatusPanel (ParentStatusPanel): real, functional, connection-state-ui's own §6.
          - Banner (ReconnectingBanner): real, functional, connection-state-ui's own §7 — additive
            overlay, never clears VideoSlot's content.
        A fresh LiveView instance is constructed only on a genuinely new Live entry (WaitingForParent
        -> Live); it is reused as-is across Live<->Reconnecting cycles within one connection attempt
        (owned by MainWindow, not this file) so neither video nor zoom state is dropped by a mere
        reconnect blip. Video (VideoView) is declared here but bound to its MediaFoundationDecoder
        from code-behind via Attach() (LiveView.xaml.cs): ConnectionStateStore.Decoder is the
        owner of that decoder's lifecycle, not this control (decode.PLAN.md §4 step 1).
    -->
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="VideoSlot">
            <video:VideoView x:Name="Video" />
            <input:TapMarkerOverlay x:Name="Overlay" />
        </Grid>

        <Border Grid.Row="1" x:Name="TextInputSlot">
            <input:TextInputBar x:Name="TextBar" />
        </Border>

        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
            <local:ParentStatusPanel x:Name="StatusPanel" />
        </Border>

        <local:ReconnectingBanner Grid.Row="0" x:Name="Banner" />
    </Grid>
</UserControl>
