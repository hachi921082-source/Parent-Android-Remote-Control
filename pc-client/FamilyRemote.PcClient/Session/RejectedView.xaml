<UserControl x:Class="FamilyRemote.PcClient.Session.RejectedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FamilyRemote.PcClient.Resources">
    <!--
        Terminal Rejected screen (GitHub issue #16, single-session-enforcement): connection-race
        loser received SESSION_BUSY and the parent closed the socket; no retry. Mirrors
        DisconnectedView.xaml exactly (one generic message + a single "Back to pairing list" action
        -> Idle/pairing-selection), reusing the same back-button string.
    -->
    <Grid Margin="24">
        <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="RejectedText" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Margin="0,0,0,16" />
            <Button x:Name="BackButton" Content="{x:Static res:Strings.SessionDisconnectedBack}"
                    HorizontalAlignment="Center" Padding="16,4" Click="OnBackClick" />
        </StackPanel>
    </Grid>
</UserControl>
