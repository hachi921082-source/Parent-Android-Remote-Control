<UserControl x:Class="FamilyRemote.PcClient.Input.TapMarkerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FamilyRemote.PcClient.Resources"
             IsHitTestVisible="False">
    <!--
        Layered above Video within LiveView's VideoSlot cell (docs/plans/pc-client/input-relay/
        PLAN.md §6, Session/LiveView.xaml). Two independent pieces of local-only feedback, both
        drawn over the video:
          - MarkerCanvas: tap/swipe marker (ShowMarker), ported from Android TapMarkerOverlay.kt.
          - BannerBorder: the view-only-mode banner (SetInputUnavailable, PLAN.md §8) — placed here
            rather than as a separate top-level LiveView.xaml element, since this is the one control
            layered above the video within VideoSlot.
        IsHitTestVisible="False" on the whole control so mouse events pass straight through to Video
        beneath it (ports Android TapMarkerOverlay.kt's "never intercepts touches itself" note) —
        Input.PointerInputController attaches its handlers directly to VideoView, not to this overlay.
    -->
    <Grid>
        <Canvas x:Name="MarkerCanvas" />
        <Border x:Name="BannerBorder" Background="#CC000000" CornerRadius="4" Padding="16,8"
                Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                Visibility="Collapsed">
            <TextBlock Text="{x:Static res:Strings.SessionInputUnavailableBanner}"
                       Foreground="White" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="480" />
        </Border>
    </Grid>
</UserControl>
