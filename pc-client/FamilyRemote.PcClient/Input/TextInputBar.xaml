<UserControl x:Class="FamilyRemote.PcClient.Input.TextInputBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FamilyRemote.PcClient.Resources">
    <!--
        Sole child of LiveView's TextInputSlot (docs/plans/pc-client/input-relay/PLAN.md §7,
        Session/LiveView.xaml). TextBox + Send button; the operator composes the full string
        locally, nothing is sent until Send (Decision #9 — no per-keystroke streaming). ToastBorder
        is the TEXT_INJECT_FAILED transient notice (§7's Snackbar-equivalent, a small custom
        Border+TextBlock with a DispatcherTimer-driven auto-hide) — placed here rather than as a
        separate LiveView.xaml element, since it's specifically about this control's own send
        attempts.
    -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ToastBorder" Grid.Row="0" Background="#CC000000" CornerRadius="4"
                Padding="12,6" Margin="0,0,0,6" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="{x:Static res:Strings.SessionTextInjectFailedNotice}" Foreground="White" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextBoxInput" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" />
            <Button x:Name="SendButton" Grid.Column="1" Content="{x:Static res:Strings.SessionTextInputSend}"
                    Padding="12,4" Click="OnSendClicked" />
        </Grid>
    </Grid>
</UserControl>
