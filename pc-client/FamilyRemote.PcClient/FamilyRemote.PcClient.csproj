<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FamilyRemote.PcClient</RootNamespace>
    <AssemblyName>FamilyRemote.PcClient</AssemblyName>
  </PropertyGroup>

  <!--
    ProtectedData: DPAPI (System.Security.Cryptography.ProtectedData.Protect/Unprotect) wrapper,
    used by Pairing/PcPairingRepository.cs to encrypt pairing_entries.json at rest
    (docs/plans/pc-client/pairing-pc-side/PLAN.md §3). Not part of the net8.0-windows base class
    library, hence the explicit NuGet reference.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!--
    Strings.resx (neutral / English fallback) is backed by a hand-authored Strings.Designer.cs
    (Resources\Strings.Designer.cs) rather than Visual Studio's ResXFileCodeGenerator single-file
    generator tool, since that tool only runs inside the VS IDE and has no plain `dotnet build`
    equivalent. The hand-authored file has the same shape VS would generate (a partial class
    wrapping a System.Resources.ResourceManager with one static string property per key) and is
    checked in like any other source file; each later plan adding a resx key also adds the
    matching property here. Strings.ja.resx / Strings.zh.resx are plain culture-qualified satellite
    resources — the SDK's default *.resx glob picks them up automatically and builds them into
    per-culture satellite assemblies (ja/, zh/) based on the filename culture suffix, no extra
    config needed; they carry no Designer.cs of their own (the ResourceManager resolves them at
    runtime via CurrentUICulture).
  -->

</Project>
