<UserControl x:Class="FamilyRemote.PcClient.Pairing.ManualPairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FamilyRemote.PcClient.Resources">
    <!--
        Two-field manual pairing screen (docs/plans/pc-client/pairing-pc-side/PLAN.md §5), followed
        by an inline label-prompt step shown on handshake success (§5's "simple second TextBox
        dialog/step" -- implemented here as a second panel within this same UserControl rather
        than a separate Window; an implementation choice that section leaves open). Hosting this
        control inside MainWindow's content-switching root, and reacting to PairingCompleted by
        handing off to the WaitingForParent flow, is owned by
        docs/plans/pc-client/connection-state-ui/PLAN.md, not this control.
    -->
    <Grid Margin="24">
        <StackPanel x:Name="ConnectPanel" MaxWidth="360" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static res:Strings.ManualPairingHostLabel}" Margin="0,0,0,4" />
            <TextBox x:Name="HostTextBox" Margin="0,0,0,12" TextChanged="OnInputChanged" />

            <TextBlock Text="{x:Static res:Strings.ManualPairingCodeLabel}" Margin="0,0,0,4" />
            <TextBox x:Name="CodeTextBox" Margin="0,0,0,12" TextChanged="OnInputChanged" />

            <TextBlock x:Name="StatusText" Margin="0,0,0,12" TextWrapping="Wrap" />

            <Button x:Name="PairButton" Content="{x:Static res:Strings.ManualPairingButton}"
                    HorizontalAlignment="Left" Padding="16,4" IsEnabled="False"
                    Click="OnPairButtonClick" />
        </StackPanel>

        <StackPanel x:Name="LabelPanel" MaxWidth="360" HorizontalAlignment="Left"
                    Visibility="Collapsed">
            <TextBlock Text="{x:Static res:Strings.LabelPromptTitle}" Margin="0,0,0,4"
                       FontWeight="Bold" />
            <TextBox x:Name="LabelTextBox" Margin="0,0,0,12" />
            <Button x:Name="SaveLabelButton" Content="{x:Static res:Strings.LabelPromptSaveButton}"
                    HorizontalAlignment="Left" Padding="16,4" Click="OnSaveLabelClick" />
        </StackPanel>
    </Grid>
</UserControl>
