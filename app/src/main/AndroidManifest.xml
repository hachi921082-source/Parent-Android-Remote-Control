<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pairing handshake and future live-session traffic (net package), all over the
         Tailscale-provided IP connectivity: see docs/plans/README.md Constants. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ParentStatusMonitor's Wi-Fi RSSI/SSID sampling (parent side), see
         docs/plans/connection-status-and-resilience/PLAN.md §5. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- QR scanning on the child device during pairing (ChildPairingScanActivity). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Screen sharing core (parent side): ScreenShareForegroundService owns the MediaProjection
         capture/encode/network session and keeps the parent's screen on while sharing. See
         docs/plans/screen-sharing-core/PLAN.md §2, §7, §8. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground-service notification visibility on Android 13+; not proactively requested at
         runtime (no dedicated request step) to preserve the widget's 2-tap design (PLAN.md §3);
         if not granted, the notification is simply not shown, the service still runs normally. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- SessionKeepAliveScheduler's Layer-2 defense-in-depth check (PLAN.md §7). Whether this is
         reliably grantable/effective on the target device is an open, tracked verification item
         (see docs/QA.md), not something this manifest declaration alone resolves. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyRemote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FamilyRemote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding wizard (parent-operated steps: accessibility walkthrough,
             MyOS checklist, pairing/QR display). Chained via ActivityResultLauncher,
             see docs/plans/pairing-and-onboarding/PLAN.md sections 5-6. -->
        <activity android:name=".pairing.OnboardingWizardActivity" android:exported="false" />
        <activity android:name=".pairing.AccessibilityOnboardingActivity" android:exported="false" />
        <activity android:name=".pairing.MyOsSetupChecklistActivity" android:exported="false" />
        <activity android:name=".pairing.ParentPairingActivity" android:exported="false" />

        <!-- Child-side pairing flow. -->
        <activity android:name=".pairing.ChildPairingScanActivity" android:exported="false" />
        <activity android:name=".pairing.PairingLabelPromptActivity" android:exported="false" />
        <activity android:name=".pairing.PairingListActivity" android:exported="false" />

        <!-- Connection status & resilience (child side). See
             docs/plans/connection-status-and-resilience/PLAN.md §2/§3. configChanges: this
             Activity owns a live socket connection across WaitingForParent/Live/Reconnecting;
             an ordinary rotation must not recreate it and drop that connection (interim measure
             pending docs/plans/screen-rotation-handling/PLAN.md's proper child-side reflow). -->
        <activity
            android:name=".child.SessionActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Screen sharing core (parent side). See docs/plans/screen-sharing-core/PLAN.md §2. -->
        <activity
            android:name=".parent.ShareStartTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".parent.ScreenShareForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Remote input control (parent side). See
             docs/plans/remote-input-control/PLAN.md §6/§7. android:permission is required by the
             platform for any AccessibilityService component; android:exported follows from that
             (only the system can bind an AccessibilityService). -->
        <service
            android:name=".parent.ParentAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".parent.SessionKeepAliveReceiver"
            android:exported="false" />

        <receiver
            android:name=".parent.ShowScreenWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/show_screen_widget_info" />
        </receiver>

    </application>

</manifest>
