<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/accessibility_onboarding_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/openSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/accessibility_onboarding_open_settings" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/batteryTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/myos_checklist_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/batterySettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/myos_checklist_step_battery_button" />

            <TextView
                android:id="@+id/batteryStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/autoStartStepText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/myos_checklist_step_autostart"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tailscaleTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/parent_pairing_tailscale_section_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tailscaleAuthKeyHelpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/parent_pairing_tailscale_authkey_help"
                android:textSize="14sp" />

            <Button
                android:id="@+id/installTailscaleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/parent_pairing_install_tailscale" />

            <Button
                android:id="@+id/openTailscaleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/parent_pairing_open_tailscale" />

            <TextView
                android:id="@+id/tailscaleStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- BOOTH-style commercial distribution needs this bundled somewhere; this screen is
                 already this app's one technical/settings-oriented destination (issue: no license
                 notice existed at all). -->
            <Button
                android:id="@+id/openSourceLicensesButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/accessibility_onboarding_licenses_link" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/continueButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="@string/action_continue"
        app:cornerRadius="16dp" />

</LinearLayout>
