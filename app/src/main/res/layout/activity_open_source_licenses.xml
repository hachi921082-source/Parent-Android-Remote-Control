<?xml version="1.0" encoding="utf-8"?>
<!-- Plain scrollable text screen (issue: no BOOTH-distribution license notice existed). No
     external links: the full Apache License 2.0 text is bundled as a raw asset so this stays
     complete and correct with the app itself, not dependent on a webpage staying up. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_source_licenses_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/introText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/open_source_licenses_intro"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/libraryListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="@string/open_source_licenses_library_list"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/licenseTextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/open_source_licenses_full_text_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/licenseFullText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
