<?xml version="1.0" encoding="utf-8"?>
<!--
    Single-screen child-side connection lifecycle host, per
    docs/plans/connection-status-and-resilience/PLAN.md §3/§4/§6: WaitingForParent / Live /
    Reconnecting / Disconnected all live in this one Activity (visibility-toggled sections) rather
    than separate Activities, since a live socket connection must not be dropped by an Activity
    transition. `liveContentContainer` now hosts remote-input-control's video surface and input
    UI (docs/plans/remote-input-control/PLAN.md §3/§5/§8/§9).
-->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- WaitingForParent (§4) -->
    <LinearLayout
        android:id="@+id/waitingSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/waitingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/listenerErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@android:color/holo_red_light"
            android:visibility="gone" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_retry"
            android:visibility="gone" />

        <Button
            android:id="@+id/waitingCancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/action_cancel" />

    </LinearLayout>

    <!-- Live (§5) / Reconnecting (§6, additive banner over the same content) -->
    <FrameLayout
        android:id="@+id/liveSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Video surface (weighted) stacked above the text input bar (wrap_content), so showing
             the input bar shrinks the video's own bounds instead of overlapping it — issue #51:
             the sender's mirrored nav bar renders at the bottom of the video, and an overlaid
             input bar made it untappable. Shrinking here re-triggers VideoDecoderView's
             onSizeChanged/letterbox recompute, so tap-coordinate mapping (which reads its
             contentRect) stays correct with no separate fix needed. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Video surface + tap/swipe input, per docs/plans/remote-input-control/PLAN.md §3/§5. -->
            <FrameLayout
                android:id="@+id/liveContentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.familyremote.app.child.VideoDecoderView
                    android:id="@+id/videoDecoderView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Never intercepts touches: see TapMarkerOverlay's own doc comment. -->
                <com.familyremote.app.child.TapMarkerOverlay
                    android:id="@+id/tapMarkerOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </FrameLayout>

            <!-- Text input bar, per PLAN.md §8 / detailed-spec §16. Starts gone, shown only while
                 the parent actually has a focused editable field (issue #38, driven by
                 InputAvailabilityViewModel.hasFocusedInputField in SessionActivity). Sized here
                 (not overlaid, see issue #51 above) so it never covers the video/nav-bar area. -->
            <LinearLayout
                android:id="@+id/textInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#CC000000"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/textInputEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/session_text_input_hint"
                    android:inputType="text"
                    android:textColor="@android:color/white"
                    android:textColorHint="#AAFFFFFF" />

                <Button
                    android:id="@+id/textInputSendButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/session_text_input_send" />

            </LinearLayout>

        </LinearLayout>

        <!-- Status/connection-loss banners, stacked at the top (§6/§7). -->
        <LinearLayout
            android:id="@+id/topOverlayBannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reconnectingBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#CC000000"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/session_reconnecting_banner"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <!-- View-only mode banner, per PLAN.md §7 / detailed-spec §11. -->
            <TextView
                android:id="@+id/viewOnlyBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#CC000000"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/session_view_only_banner"
                android:textColor="@android:color/white"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Parent device status summary, small overlay corner (§9). -->
        <TextView
            android:id="@+id/liveStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="#99000000"
            android:padding="8dp"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <!-- FLAG_SECURE help hint, per PLAN.md §9 / detailed-spec §5. Starts gone, shown only
             while the video actually looks black (issue #39, driven by
             VideoDecoderView.isContentBlank in SessionActivity). -->
        <ImageButton
            android:id="@+id/flagSecureHelpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/session_help_hint_desc"
            android:padding="8dp"
            android:src="@android:drawable/ic_dialog_info"
            android:visibility="gone"
            app:tint="@android:color/white" />

    </FrameLayout>

    <!-- Disconnected (§6) -->
    <LinearLayout
        android:id="@+id/disconnectedSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/disconnectedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/disconnectedBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/session_disconnected_back" />

    </LinearLayout>

    <!-- Rejected (docs/plans/single-session-enforcement/PLAN.md §6): another client already holds
         the parent's single Live slot. Mirrors disconnectedSection's layout pattern exactly,
         reusing session_disconnected_back for the same "back to device list" action. -->
    <LinearLayout
        android:id="@+id/rejectedSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/rejectedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <!-- issue #46: an actual navigable link to the sender's "Manage Viewers" screen isn't
             possible here in general. That screen's data lives locally on whichever device is
             acting as sender, a different physical device in the normal (not dual-role-testing)
             case, so this device has no way to reach it over the network. Guidance text instead. -->
        <TextView
            android:id="@+id/rejectedHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/session_rejected_hint"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <Button
            android:id="@+id/rejectedBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/session_disconnected_back" />

    </LinearLayout>

</FrameLayout>
