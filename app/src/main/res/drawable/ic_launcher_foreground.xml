<?xml version="1.0" encoding="utf-8"?>
<!--
    "つながる画面" launcher icon foreground layer: two overlapping screens (sender behind,
    receiver in front) with a fingertip tapping the receiver's screen (ripple rings) and a small
    echo dot on the sender's screen at the corresponding, mostly-occluded spot, showing that the
    tap is relayed across. Coordinates match the 108x108 adaptive-icon canvas used for design
    review (see the icon-concepts artifact this was picked from).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sender's screen (back), rotated -10 degrees about (43,46). -->
    <group android:pivotX="43" android:pivotY="46" android:rotation="-10">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M34,24 H52 A6,6 0 0 1 58,30 V62 A6,6 0 0 1 52,68 H34 A6,6 0 0 1 28,62 V30 A6,6 0 0 1 34,24 Z" />
        <!-- Echo of the tap landing here, mostly hidden behind the receiver's screen drawn after it. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF5EAE6B"
            android:strokeWidth="1.4"
            android:strokeAlpha="0.45"
            android:pathData="M37,57 A8,8 0 1,0 53,57 A8,8 0 1,0 37,57 Z" />
        <path
            android:fillColor="#FF5EAE6B"
            android:pathData="M40.5,57 A4.5,4.5 0 1,0 49.5,57 A4.5,4.5 0 1,0 40.5,57 Z" />
    </group>

    <!-- Receiver's screen (front), rotated 8 degrees about (65,62). -->
    <group android:pivotX="65" android:pivotY="62" android:rotation="8">
        <path
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FF3D7DBF"
            android:strokeWidth="2.5"
            android:pathData="M56,40 H74 A6,6 0 0 1 80,46 V78 A6,6 0 0 1 74,84 H56 A6,6 0 0 1 50,78 V46 A6,6 0 0 1 56,40 Z" />
    </group>

    <!-- Tap ripple + fingertip, on the unrotated canvas over the receiver's screen. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF5EAE6B"
        android:strokeWidth="1.6"
        android:strokeAlpha="0.5"
        android:pathData="M57,73 A10,10 0 1,0 77,73 A10,10 0 1,0 57,73 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF5EAE6B"
        android:strokeWidth="2"
        android:strokeAlpha="0.9"
        android:pathData="M61,73 A6,6 0 1,0 73,73 A6,6 0 1,0 61,73 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF5EAE6B"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:pathData="M85,93 L67,73" />
</vector>
